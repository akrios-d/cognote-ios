    },
    "onboarding.step2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movies, books, series, conversations — each in its own space. No more scattered notes or forgotten impressions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films, livres, séries, conversations — chacun dans son espace. Fini les notes éparpillées ou les impressions oubliées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes, livros, séries, conversas — cada um no seu espaço. Sem anotações espalhadas ou impressões esquecidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电影、书籍、剧集、对话——每类都有专属空间。不再有散落的笔记或遗忘的感受。"
          }
        }
      }
    },
    "onboarding.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One place for everything."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout au même endroit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lugar para tudo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个地方，记录一切。"
          }
        }
      }
    },
    "onboarding.step3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark whether it hit you positively or negatively, and how deeply. A difficult film can leave a deeper mark than a pleasant one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez si cela vous a touché positivement ou négativement, et à quelle profondeur. Un film difficile peut laisser une trace plus profonde qu'un agréable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque se te afetou de forma positiva ou negativa, e com que intensidade. Um filme difícil pode marcar mais do que um agradável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记它是正面还是负面影响，以及影响有多深。一部沉重的电影，可能比愉快的留下更深的印记。"
          }
        }
      }
    },
    "onboarding.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not just stars. Depth and direction."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas seulement des étoiles. Direction et profondeur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não só uma nota. Direção e profundidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不只是评分，还有方向与深度。"
          }
        }
      }
