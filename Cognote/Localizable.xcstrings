    "backup.modeMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge keeps what you have and adds or updates from the file. Replace erases the current data first; a safety copy is saved so you can undo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juntar mantém o que você já tem e adiciona ou atualiza a partir do arquivo. Substituir apaga os dados atuais antes; uma cópia de segurança é salva para você poder desfazer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionner conserve vos données et ajoute ou met à jour depuis le fichier. Remplacer efface d'abord les données actuelles ; une copie de sécurité est enregistrée pour pouvoir annuler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并会保留现有数据，并根据文件新增或更新。替换会先清除当前数据；系统会保存一份安全副本，方便撤销。"
          }
        }
      }
    },
    "backup.modeTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
