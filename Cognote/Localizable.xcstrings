    "onboarding.step1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CogNote tracks the emotional impact of what you watch, read, and experience — and shows you the patterns over time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CogNote suit l'impact émotionnel de ce que vous regardez, lisez et vivez — et vous montre les tendances au fil du temps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CogNote registra o impacto emocional do que você assiste, lê e experimenta — e mostra os padrões ao longo do tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CogNote 追踪你观看、阅读和经历的情感影响——并随时间呈现规律。"
          }
        }
      }
    },
    "onboarding.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you consume shapes who you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous consommez vous façonne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você consome te molda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你消费的内容塑造了你。"
          }
        }
